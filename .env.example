# --- Speech-to-text (Deepgram Nova-3) ---------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Diarization (pyannote community-1; accept the model terms on Hugging Face first) ---
HF_TOKEN=
PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cpu            # cuda | mps | cpu

# --- LLMs (extraction, judge, real-time answers) ----------------------------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5     # different from the extractor to limit self-preference bias
REALTIME_LLM_MODEL=claude-haiku-5-5

# --- Speech synthesis (ElevenLabs; your own key — LiveKit Inference no longer serves ElevenLabs) ---
ELEVEN_API_KEY=
ELEVEN_MODEL=eleven_v3_conversational   # fall back to eleven_flash_v2_5 if your plugin version rejects it
ELEVEN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- LiveKit Cloud -----------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Arize (optional tracing) ------------------------------------------------
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=conversation-intelligence

# --- Storage -----------------------------------------------------------------
CI_DATA_DIR=data
CI_OUTPUT_DIR=outputs
